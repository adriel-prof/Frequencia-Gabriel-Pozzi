rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função utilitária para verificar se o usuário logado tem o domínio institucional correto
    function isProf() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email.matches('(?i).*@prof[.]educacao[.]sp[.]gov[.]br$') ||
        request.auth.token.email.matches('(?i).*@servidor[.]educacao[.]sp[.]gov[.]br$') ||
        request.auth.token.email.matches('(?i).*@educacao[.]sp[.]gov[.]br$')
      );
    }

    // Função para verificar se o usuário é administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "adrielsilva@prof.educacao.sp.gov.br" ||
        (exists(/databases/$(database)/documents/roles/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'admin')
      );
    }

    // Regras da coleção 'roles'
    match /roles/{email} {
      // Qualquer professor logado pode ler/escrever seu próprio documento de role (necessário para cadastro no primeiro login)
      allow read, write: if isProf() && request.auth.token.email == email;
      // Administradores podem ler e gravar qualquer documento da coleção roles
      allow read, write: if isAdmin();
    }

    // Regras da coleção 'students'
    match /students/{docId} {
      allow read: if isProf();
      allow write: if isProf() && (isAdmin() || request.auth.token.email == "gestor_email@prof.educacao.sp.gov.br");
    }

    // Regras da coleção 'attendance'
    match /attendance/{docId} {
      allow read: if isProf();
      allow create, update: if isProf(); // Permite criar e atualizar a chamada (ex: aluno atrasado)
      allow delete: if isAdmin(); // Apenas Administradores podem deletar
    }

    // Regras da coleção 'daily_summaries'
    match /daily_summaries/{docId} {
      allow read: if isProf();
      allow create, update: if isProf(); // Permite criar e atualizar o resumo diário
      allow delete: if isAdmin();
    }

    // Regras da coleção 'attendance_history'
    match /attendance_history/{docId} {
      allow read, create: if isProf();
      allow update, delete: if isAdmin();
    }
    
    // Regras da coleção 'settings'
    match /settings/{docId} {
      allow read: if isProf();
      allow write: if isAdmin();
    }

    // Regras da coleção 'blocked_dates'
    match /blocked_dates/{docId} {
      allow read: if isProf();
      allow write: if isAdmin();
    }

    // Fallback retrocompatível para 'config'
    match /config/{docId} {
      allow read: if isProf();
      allow write: if isAdmin();
    }
  }
}
